#!/bin/bash
set -e

# Script to auto build and install ragtag. Just provide the version

function usage() {
 cat << EOF
Usage: ${0} <VERSION>

 <VERSION> is the specific version number you're building

EOF
}

# Quit the script if it doesn't have enough flags set
if [ $# -lt 1 ]; then
 usage
 exit 1
fi

VERSION=$1
DATE=`date +"%d/%m/%Y %r"`
echo "Building ragtag ${VERSION} on ${DATE}"
# Get the source so we have the changes
# Actual install is done from pip in venv
mkdir -p /opt/bioit/ragtag/${VERSION}
# Handle differences between Rocky and CentOS
if [ $(cat /etc/redhat-release | grep -ci "rocky") -eq 1 ]; then
  # Rocky Linux
  /usr/bin/python3.9 -m venv /opt/bioit/ragtag/${VERSION}/venv
else
  # CentOS Linux
  /opt/rh/rh-python38/root/usr/bin/python -m venv /opt/bioit/ragtag/${VERSION}/venv
fi
# Need to upgrade pip for install to work
/opt/bioit/ragtag/${VERSION}/venv/bin/pip3 install --upgrade pip
/opt/bioit/ragtag/${VERSION}/venv/bin/pip3 install ragtag==${VERSION}
echo "Writing modulefile"
echo "#%Module 1.0
#
#  cutadapt module for use with 'environment-modules' package:
#
prepend-path  PATH              /opt/bioit/ragtag/${VERSION}/venv/bin" > /opt/bioit/modulefiles/ragtag/${VERSION}
echo "Writing module .version to set default"
echo "#%Module1.0
##
##  The desired version of ragtag
##
set ModulesVersion ${VERSION}" > /opt/bioit/modulefiles/ragtag/.version
